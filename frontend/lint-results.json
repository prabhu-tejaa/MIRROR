EFIX' | translate }}<a id=\"open-terms\" class=\"signup-link\"\r\n                style=\"display: inline-block; padding: 2px 4px; position: relative; z-index: 100;\">{{ 'SIGNUP.TOS_LINK'\r\n                | translate }}</a>\r\n            </span>\r\n          </div>\r\n\r\n          <ion-modal #modal trigger=\"open-terms\" class=\"premium-modal\">\r\n            <ng-template>\r\n              <ion-header class=\"ion-no-border\">\r\n                <ion-toolbar class=\"glassy-toolbar\">\r\n                  <ion-title>{{ 'SIGNUP.TOS_LINK' | translate }}</ion-title>\r\n                  <ion-buttons slot=\"end\">\r\n                    <ion-button class=\"close-btn\" (click)=\"modal.dismiss()\">\r\n                      <ion-icon [icon]=\"closeOutline\"></ion-icon>\r\n                    </ion-button>\r\n                  </ion-buttons>\r\n                </ion-toolbar>\r\n              </ion-header>\r\n              <ion-content class=\"ion-padding glassy-modal-content\">\r\n                <div class=\"modal-body glassy-body\">\r\n                  <div class=\"tos-header-badge\">\r\n                    <ion-icon class=\"tos-badge-icon\" [icon]=\"shieldCheckmarkOutline\"></ion-icon>\r\n                    <span>SECURE &amp; VERIFIED ACADEMIC SANDBOX</span>\r\n                  </div>\r\n                  <p [innerHTML]=\"'SIGNUP.TOS_SUBTITLE' | translate\"></p>\r\n\r\n                  <div class=\"rules-list\">\r\n                    <div class=\"rule-item\">\r\n                      <span class=\"rule-index\">01</span>\r\n                      <p [innerHTML]=\"'SIGNUP.RULE_1' | translate\"></p>\r\n                    </div>\r\n                    <div class=\"rule-item\">\r\n                      <span class=\"rule-index\">02</span>\r\n                      <p [innerHTML]=\"'SIGNUP.RULE_2' | translate\"></p>\r\n                    </div>\r\n                    <div class=\"rule-item\">\r\n                      <span class=\"rule-index\">03</span>\r\n            