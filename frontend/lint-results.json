ne":111,"endColumn":95},{"ruleId":"@angular-eslint/template/no-inline-styles","severity":2,"message":"<div/> element should not have inline styles via style attribute. Please use classes instead.","line":132,"column":11,"nodeType":null,"messageId":"noInlineStyles","endLine":145,"endColumn":17}],"suppressedMessages":[],"errorCount":17,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"<ion-content [fullscreen]=\"true\" [scrollY]=\"true\">\n  <div class=\"mind-space-wrapper\" [class.animations-paused]=\"!isTabActive()\">\n\n\n    <div class=\"aura-visualization-area\">\n      <div #auraStage class=\"aura-stage-container\" [class.animate-intro]=\"shouldAnimateIntro\">\n\n        <div tabindex=\"0\" class=\"aura-orb dominant-orb glassy-core\" [class.animate-intro]=\"shouldAnimateIntro\" [style.--dynamic-aura-gradient]=\"auraGradient()\" [style.--aura-opacity]=\"totalCount() > 0 ? 1 : 0\" [style.cursor]=\"totalCount() > 0 ? 'grab' : 'default'\" (pointerdown)=\"onCenterPointerDown($event)\" (click)=\"!hasDragged && totalCount() > 0 && isAllEmotionsOpen.set(true)\" (keyup.enter)=\"!hasDragged && totalCount() > 0 && isAllEmotionsOpen.set(true)\">\n          <span class=\"orb-label\">{{ displayUsername() }}</span>\n        </div>\n\n        @if (totalCount() > 0) {\n          <div class=\"outer-orbs-wrapper\" [class.play-fade-in]=\"isFirstVisit\">\n            @for (stat of topOrbs(); track trackByKey(i, stat); let i = $index) {\n              <div\n                tabindex=\"0\"\n                class=\"aura-orb cursor-pointer\"\n                [ngClass]=\"orbClasses[i]\"\n                [style.--orb-scale]=\"stat.orbScale\"\n                [style.--orb-color]=\"stat.primaryColor\"\n                [style.background]=\"stat.primaryColor\"\n                [style.box-shadow]=\"'0 0 28px ' + stat.primaryColor\"\n                (click)=\"selectEmotion(stat.key)\"\n                (keyup.enter)=\"selectEmotion(stat.key)\">\n              </div>\n            }\n          </div>\n        }\n\n      </div>\n\n      @if (totalCount() === 0) {\n        <div class=\"status-overlay\">\n          @if (isLoading()) {\n            <div class=\"syncing-indicator\">\n              <span>Syncing Aura...</span>\n            </div>\n          }\n          @if (!isLoading()) {\n            <div class=\"empty-guidance-card\">\n              <h3>Your Mind Space</h3>\n              <p>Your aura is currently clear. Start a reflection in the chat to begin mapping your emotions.</p>\n              <button class=\"btn-reflect-now\" (click)=\"startReflection()\">\n                Begin Reflection\n              </button>\n            </div>\n          }\n        </div>\n      }\n    </div>\n\n    @if (totalCount() > 0) {\n      <div class=\"emotion-text-selectors\" [class.play-fade-in]=\"isFirstVisit\">\n        @for (stat of topOrbs(); track trackByKey($index, stat)) {\n          <button\n            class=\"emotion-text-btn\"\n            [class.active]=\"selectedEmotion() === stat.key\"\n            [style.color]=\"stat.primaryColor\"\n            [style.text-shadow]=\"getTextShadow(stat.key, stat.primaryColor)\"\n            (click)=\"selectEmotion(stat.key)\">\n            {{ stat.name }}\n          </button>\n        }\n      </div>\n    }\n\n    @if (selectedEmotion() || isAllEmotionsOpen()) {\n      <div class=\"timeline-popup-overlay\" tabindex=\"0\" (click)=\"closeModals()\" (keyup.enter)=\"closeModals()\">\n        <div tabindex=\"0\" class=\"timeline-popup-card\" style=\"transition: border-color 0.3s ease;\" [style.border-color]=\"modalBorderColor()\" (click)=\"$event.stopPropagation()\" (keyup.enter)=\"$event.stopPropagation()\">\n          @if (selectedEmotion()) {\n            <div class=\"popup-header\">\n              <button class=\"btn-back-popup\" [style.visibility]=\"openedFromAllEmotions() ? 'visible' : 'hidden'\" (click)=\"goBackToAllEmotions()\">←</button>\n              <h4 style=\"text-align: center;\">Reflections: <span [style.color]=\"selectedEmotionStat().primaryColor\">{{ selectedEmotionStat().name }}</span></h4>\n              <button class=\"btn-close-popup\" (click)=\"closeModals()\">✕</button>\n            </div>\n            <div class=\"popup-scroller\">\n              @for (item of filteredReflections(); track trackByCreatedAt($index, item)) {\n                <div class=\"popup-card\">\n                  <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;\">\n                    <span class=\"card-time\" style=\"margin-bottom: 0;\">{{ item.createdAt | date:'shortTime' }} • {{ item.createdAt | date:'mediumDate' }}</span>\n                    @if (item.originalEmotionName) {\n                      <span style=\"font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 12px; border: 1px solid currentColor;\" [style.color]=\"selectedEmotionStat().primaryColor\">{{ item.originalEmotionName }}</span>\n                    }\n                  </div>\n                  <p class=\"card-text\" style=\"margin-top: 0;\">\"{{ item.content }}\"</p>\n                </div>\n              }\n              @if (filteredReflections().length === 0) {\n                <div class=\"empty-popup-logs\">\n                  <p class=\"no-memories-text\">No reflections recorded for this emotion state yet.</p>\n                </div>\n              }\n            </div>\n          }\n          @if (isAllEmotionsOpen() && !selectedEmotion()) {\n            <div class=\"popup-header\">\n              <h4 style=\"text-transform: uppercase;\">{{ displayUsername() }}'s Emotional States</h4>\n              <button class=\"btn-close-popup\" (click)=\"closeModals()\">✕</button>\n            </div>\n            <div class=\"popup-scroller\" style=\"max-height: 280px;\">\n              <div class=\"all-emotions-grid\" style=\"display: flex; flex-direction: column; gap: 10px; margin-top: 10px;\">\n                @for (stat of emotionStats(); track trackByKey($index, stat)) {\n                  <button\n                    class=\"emotion-list-item-btn\"\n                    style=\"background: rgba(255, 255, 255, 0.03); border: 1px solid; border-radius: 12px; padding: 12px; font-weight: 600; font-size: 14px; text-align: left; display: flex; justify-content: space-between; align-items: center; transition: all 0.2s;\"\n                    [style.color]=\"stat.primaryColor\"\n                    [style.border-color]=\"stat.primaryColor\"\n                    (click)=\"selectFromAllEmotions(stat.key)\"\n                    >\n                    <span>{{ stat.name }}</span>\n                    <span style=\"font-size: 12px; opacity: 0.7;\">{{ stat.percentage }}%</span>\n                  </button>\n                }\n              </div>\n            </div>\n          }\n        </div>\n      </div>\n    }\n\n    <div class=\"music-floating-system\">\n      <button class=\"floating-music-btn\" [class.playing]=\"isPlaying()\" [class.loading]=\"isLoadingAudio()\" [disabled]=\"isLoadingAudio()\" (click)=\"togglePlay()\">\n        @if (isLoadingAudio()) {\n          <div class=\"music-btn-spinner\"></div>\n        }\n        @if (!isPlaying() && !isLoadingAudio()) {\n          <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"currentColor\" class=\"music-icon-svg\">\n            <path d=\"M8 5v14l11-7z\"/>\n          </svg>\n        }\n        @if (isPlaying() && !isLoadingAudio()) {\n          <div class=\"playing-spectrum\"\n            [style.--bar1-scale]=\"scale1()\"\n            [style.--bar2-scale]=\"scale2()\"\n            [style.--bar3-scale]=\"scale3()\"\n            [style.--bar4-scale]=\"scale4()\"\n            [style.--color-1]=\"topOrbs()[0]?.primaryColor || '#ffffff'\"\n            [style.--color-2]=\"topOrbs()[1]?.primaryColor || '#ffffff'\"\n            [style.--color-3]=\"topOrbs()[2]?.primaryColor || '#ffffff'\"\n            [style.--color-4]=\"topOrbs()[3]?.primaryColor || '#ffffff'\">\n            <span class=\"spec-bar bar-1\"></span>\n            <span class=\"spec-bar bar-2\"></span>\n            <span class=\"spec-bar bar-3\"></span>\n            <span class=\"spec-bar bar-4\"></span>\n          </div>\n        }\n      </button>\n    </div>\n\n  </div>\n</ion-content>","usedDeprecatedRules":[]}]
