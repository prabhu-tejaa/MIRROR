</ion-icon>\n                              </button>\n                            </td>\n                          </tr>\n                        }\n                      </tbody>\n                    </table>\n                  </div>\n                </div>\n              }\n            </div>\n          }\n        </div>\n      }\n    </div>\n  }\n\n  <ion-modal class=\"glassy-modal memory-modal\" [isOpen]=\"isModalOpenValue\" (didDismiss)=\"closeModal()\">\n    <ng-template>\n      <ion-header class=\"glassy-modal-header\">\n        <ion-toolbar>\n          <ion-title>{{ modalTitleValue }}</ion-title>\n          <ion-buttons slot=\"end\">\n            <ion-button (click)=\"closeModal()\">\n              <ion-icon name=\"close-outline\"></ion-icon>\n            </ion-button>\n          </ion-buttons>\n        </ion-toolbar>\n      </ion-header>\n      <div class=\"ion-padding glassy-modal-content modal-body-scroll\">\n        <div class=\"modal-form-wrapper\">\n\n          <div class=\"user-overview\">\n            <div class=\"modal-avatar\" [ngClass]=\"{'create-avatar': modalMode === 'ADD'}\">\n              @if (modalMode === 'ADD') {\n                <ion-icon name=\"server-outline\"></ion-icon>\n              }\n              @if (modalMode === 'EDIT') {\n                <ion-icon name=\"create-outline\"></ion-icon>\n              }\n            </div>\n            <div class=\"user-meta\">\n              <h3>{{ modalMode === 'ADD' ? 'New Memory Record' : 'Editing Record' }}</h3>\n              <p class=\"user-id-sub\">This record will be synced to the Postgres vector DB.</p>\n            </div>\n          </div>\n\n          <form class=\"modal-form\" (ngSubmit)=\"saveModalRecord()\">\n            <div class=\"form-group\">\n              <label class=\"field-label\" for=\"userEmailInput\">User Email</label>\n              <div class=\"input-wrapper\">\n                <ion-icon name=\"mail-outline\" class=\"input-icon\"></ion-icon>\n                <input 