{
  "name": "MIRЯOЯ",
  "version": "1.0.0",
  "author": "Prabhu Teja Pamula",
  "homepage": "https://projectmirror.tech",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/set-env.js && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/set-env.js && ng test",
    "test:edge": "set \"CHROME_BIN=C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\" && npm run test -- --browsers=Edge",
    "test:edge-headless": "set \"CHROME_BIN=C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\" && npm run test -- --watch=false --browsers=EdgeHeadless",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "ci": "npm run lint && npm run test:edge",
    "android:build": "node scripts/set-env.js && npm run android:clean && ionic build && npx cap sync android && npx cap open android",
    "android:live": "ionic cap run android -l --external --host=0.0.0.0 --target=5386e850",
    "android:clean": "cd android && gradlew clean && cd ..",
    "assets:generate": "capacitor-assets generate --android && npx cap sync android"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-firebase/analytics": "^8.1.0",
    "@capacitor/android": "8.2.0",
    "@capacitor/app": "8.0.1",
    "@capacitor/core": "8.2.0",
    "@capacitor/haptics": "8.0.1",
    "@capacitor/keyboard": "8.0.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/status-bar": "8.0.1",
    "@ionic/angular": "^8.0.0",
    "@ngrx/effects": "^20.1.0",
    "@ngrx/store": "^20.1.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.11.0",
    "ionicons": "^7.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
